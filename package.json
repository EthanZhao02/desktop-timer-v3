{
  "name": "zhiyu-timer",
  "version": "1.1.4",
  "description": "智域计时 - 桌面计时器与桌面宠物",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test:ui": "electron tests/capture-ui.js",
    "verify:package": "node tests/verify-package.js",
    "build": "electron-builder",
    "build-win": "electron-builder --win nsis portable --x64 --publish never",
    "build-portable": "electron-builder --win portable --x64 --publish never",
    "build-mac-arm64": "electron-builder --mac dmg zip --arm64 --publish never",
    "build-mac-x64": "electron-builder --mac zip --x64 --publish never"
  },
  "author": "Ethan智域小店",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cn.ethan.zhiyu-timer",
    "productName": "智域计时",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智域计时",
      "uninstallDisplayName": "智域计时",
      "artifactName": "Zhiyu-Timer-${version}-Windows-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Zhiyu-Timer-${version}-Windows-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Zhiyu-Timer-${version}-macOS-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "timer-core.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "pet.html",
      "pet.css",
      "pet.js",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/icon.ico",
      "assets/icon.png",
      "assets/tray-icon.png"
    ]
  }
}
